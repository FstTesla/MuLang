    ins constant 1 1 %0 t0 int 42
    ins constant 2 1 %2 t2 null
    ins constant 3 1 %3 t3 float negative-zero
    ins constant 4 1 %3 t3 float nan
    ins constant 5 1 %3 t3 float positive-infinity
    ins constant 6 1 %3 t3 float negative-infinity
    ins constant 7 1 %3 t3 float 1.2345678901234567
    ins constant 8 1 %4 t4 string "a\n\"b\"\u{1}"
    ins copy 8 1 %9 %0
    ins load-global 9 1 %0 "global.value"
