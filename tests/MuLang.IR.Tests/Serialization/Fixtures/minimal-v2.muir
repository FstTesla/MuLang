muir 2
mode expression
environment "env"
profile "profile"
types 1
type t0 intrinsic int

entry "$entry" t0 bb0 slots 1 blocks 1 lifetime-regions 1 exception-regions 0 {
  lifetime-region lr0 parent none entry bb0
  slot %0 temporary t0 mutable none region lr0
  block bb0 region lr0 instructions 1 {
    ins constant 0 1 %0 t0 int 42
    term return 0 1 %0
  }
}
users 0
end
