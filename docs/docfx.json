{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/MuLang.Core/bin/Release/net10.0/MuLang.Core.dll",
            "src/MuLang.IR/bin/Release/net10.0/MuLang.IR.dll",
            "src/MuLang.Compiler/bin/Release/net10.0/MuLang.Compiler.dll",
            "src/MuLang.Exporters.DotNet/bin/Release/net10.0/MuLang.Exporters.DotNet.dll",
            "src/MuLang.StandardLibrary/bin/Release/net10.0/MuLang.StandardLibrary.dll",
            "src/MuLang.StandardLibrary.DotNet/bin/Release/net10.0/MuLang.StandardLibrary.DotNet.dll"
          ],
          "src": ".."
        }
      ],
      "dest": "../artifacts/docs/api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/toc.yml"
        ],
        "src": "public"
      },
      {
        "files": [
          "**/*.yml"
        ],
        "src": "../artifacts/docs/api",
        "dest": "api"
      }
    ],
    "resource": [
      {
        "files": [
          "MuLang.png"
        ],
        "src": "..",
        "dest": "images"
      }
    ],
    "output": "../artifacts/docs/site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appBasePath": "/MuLang/",
      "_appLogoPath": "images/MuLang.png",
      "_appName": "MuLang",
      "_appTitle": "MuLang Documentation",
      "_enableSearch": true
    }
  }
}
